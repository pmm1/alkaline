# --- Login -------------------------------------------------------------
# The password you type on the login screen.
APP_PASSWORD=change-me
# Long random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# How long you stay logged in on a device.
SESSION_DAYS=30

# --- Z.ai --------------------------------------------------------------
ZAI_API_KEY=
# Coding Plan: https://api.z.ai/api/coding/paas/v4
# Standard API (resource packages, e.g. the GLM-5.3-Flash trial): https://api.z.ai/api/paas/v4
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
ZAI_MODEL=glm-5.3
# true = the model "thinks" before answering (slower, uses more quota).
ZAI_THINKING=false
# Only for models that can't turn thinking off (glm-5.3-flash on the standard API):
# low = fastest. When set, this replaces ZAI_THINKING.
# ZAI_REASONING_EFFORT=low

# --- Server ------------------------------------------------------------
HOST=127.0.0.1
PORT=8080
# Secure cookies are on automatically in production (HTTPS). Uncomment to override.
# COOKIE_SECURE=false
# Where chats are stored (SQLite). Default: data/alkaline.db
# DB_FILE=data/alkaline.db
